#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
out=$(mktemp -d /tmp/vim-reconcile-tests.XXXXXX)
"$root/scripts/clang-with-swift-packages" GuestControl MachineKit -- -fobjc-arc -fmodules -framework Foundation \
    -mmacosx-version-min=15.0 -I "$root/VirtualIntelMac" \
    "$root/probes/installation-reconcile-tests.m" \
    "$root/VirtualIntelMac/VIMGuestInstallation.m" "$root/VirtualIntelMac/VIMGuestBootPolicy.m" -o "$out/test"
"$out/test"
