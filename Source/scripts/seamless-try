#!/bin/zsh
# Runs a seamless-apps probe in a throwaway clone, with nobody at the guest. Results print here and go to
# Build/seamless/. The clone's window is titled "Clone of <machine>".
#
#     scripts/seamless-try stream <app> <machine> [SECONDS]    Phase 1: TextEdit as its own host window.
#     scripts/seamless-try display <app> <machine> [WxH ...]   How large a guest display works, and slot placement.
#     scripts/seamless-try input <app> <machine>               What a test NSView in the guest receives. See seamless-input.md.
#     scripts/seamless-try input-live <app> <machine> [SECONDS]  The same with your own trackpad, in a host window.
#     scripts/seamless-try tree <app> <machine> [SECONDS]      Every window of a demo app as its own host window: shadow,
#                                                              alpha, popover, panel, menu and sheet.
#     scripts/seamless-try ws-probe <app> <machine>            Loads a read-only probe into a 10.9 clone's WindowServer.
#
# `display` needs an app built from this branch, for its display-request diagnostic. `stream` works with any recent one.
set -euo pipefail
source_root=${0:A:h:h}
mode=${1:?usage: seamless-try stream|display|tree|ws-probe|input|input-live <app> <machine> [arguments]}
app=${2:?usage: seamless-try stream|display|tree|ws-probe|input|input-live <app> <machine> [arguments]}
machine=${3:?usage: seamless-try stream|display|tree|ws-probe|input|input-live <app> <machine> [arguments]}
shift 3
"$source_root/scripts/build-seamless-probes" "$source_root/Build/seamless" 2>/dev/null
driver_arguments=(--driver-arg "$mode")
for argument in "$@"; do driver_arguments+=(--driver-arg "$argument"); done
exec "$source_root/scripts/guest-bench" "$app" "$machine" "seamless-$mode" \
    --driver "$source_root/probes/seamless-driver.py" "${driver_arguments[@]}"
