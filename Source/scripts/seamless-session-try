#!/usr/bin/env python3
"""One guest app as a host app, from nothing running to nothing left, in throwaway clones of the app and machine.

    VIM_CODESIGN_IDENTITY=<sha1> scripts/seamless-session-try <app> <machine.vintelmac>

Generates a TextEdit proxy and opens it with a document, as LaunchServices would for a Dock tile or a drop, with no VM
running. The proxy starts the app with no window, the app starts the session, the guest boots, and the document opens. The
session then types into the document and a new one, asks the proxy to quit, answers the save prompt that brings, and the
machine shuts down. Prints PASS or FAIL per step. Composed images of the guest's windows, which are made from their exact
pixels and not read from the screen, are in Build/seamless/seamless-session-screen-*.png.
"""
import json
import os
from pathlib import Path
import plistlib
import shutil
import signal
import subprocess
import sys
import tempfile
import time

source = Path(__file__).resolve().parents[1]
if len(sys.argv) != 3:
    sys.exit(__doc__)
original_app, original_machine = Path(sys.argv[1]), Path(sys.argv[2])
results = source/'Build/seamless'
work = source/'Build/bench/seamless-session'
shutil.rmtree(work, ignore_errors=True)
home = work/'home'
library = home/'Library/Application Support/Light Click/Machines'
library.mkdir(parents=True)
machine = library/f'Clone of {original_machine.name}'
subprocess.run(['cp', '-c', '-R', str(original_machine), str(machine)], check=True)
(machine/'State/PendingConfiguration.plist').unlink(missing_ok=True)
for key in ('SSHEnabled', 'FileSharingEnabled'):
    subprocess.run(['plutil', '-replace', key, '-bool', 'NO', str(machine/'Machine.plist')], check=True)
print(f'WARNING: "{machine.stem}" is a throwaway clone, and preferences stay shared with the real app.', flush=True)
app = work/original_app.name
subprocess.run(['cp', '-c', '-R', str(original_app), str(app)], check=True)
subprocess.run([str(source/'scripts/seamless-package'), str(app)], check=True)
identifier = plistlib.loads((machine/'Machine.plist').read_bytes())['Identifier']

failures = 0


def check(name, passed, detail=''):
    global failures
    failures += not passed
    print(f'{"PASS" if passed else "FAIL"} {name}{": " + detail if detail else ""}', flush=True)


def running(pattern):
    rows = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, text=True).stdout.splitlines()
    return [row.strip() for row in rows if pattern in row and 'seamless-session-try' not in row]


# The per-user temporary folder, since anyone can make a socket in /tmp, and the socket's path has a short limit.
folder = Path(tempfile.gettempdir())/f'lc-{identifier[:8].lower()}'
shutil.rmtree(folder, ignore_errors=True)
folder.mkdir(mode=0o700)
socket_path = folder/'s'
catalog = work/'apps.json'
catalog.write_text(json.dumps([{'bundleIdentifier': 'com.apple.TextEdit', 'name': 'TextEdit', 'guestPath': '/Applications/TextEdit.app',
                                'documentTypes': [{'name': 'Text', 'extensions': ['txt'], 'contentTypes': ['public.plain-text'], 'osTypes': []}],
                                'urlSchemes': []}]))
bundle = subprocess.run([str(app/'Contents/Resources/Seamless/SeamlessMakeProxy'), 'write', str(catalog), 'TextEdit', identifier, 'Mavericks',
                         str(machine), str(work/'proxies'), str(app/'Contents/Resources/Seamless/SeamlessProxy'), str(socket_path), '',
                         str(app)], capture_output=True, text=True, check=True).stdout.strip()
bundle_id = plistlib.loads((Path(bundle)/'Contents/Info.plist').read_bytes())['CFBundleIdentifier']
document = work/'A note from the host.txt'
document.write_text('Written on the host.\n')
before = document.read_bytes()
for old in results.glob('seamless-session-*.png'):
    old.unlink()

check('no machine is running this clone before the proxy opens', not running(str(machine)))
arguments = '\n'.join(['--test-session', '--png', str(results/'seamless-session-window'),
                       '--screenshots', str(results/'seamless-session-screen')])
subprocess.run(['/usr/bin/open', '--env', f'CFFIXED_USER_HOME={home}', '--env', f'LC_SEAMLESS_VIEWER_ARGS={arguments}', '-a', bundle, str(document)], check=True)
print('# opened the proxy with a document; the guest boots now, which takes some minutes, more on a first session', flush=True)

log = Path(str(socket_path)+'.log')
launch_checked = False
deadline = time.time()+1500
said = ''
while time.time() < deadline:
    said = log.read_text(errors='replace') if log.exists() else ''
    if not launch_checked and 'running TextEdit' in said:
        launch_checked = True
        def kind(pattern):
            pid = running(pattern)[0].split()[0] if running(pattern) else '0'
            listing = subprocess.run(['lsappinfo', 'list'], capture_output=True, text=True).stdout
            return next((line.strip() for line in listing.splitlines() if f'pid = {pid} ' in line), '')
        proxy_kind = kind(f'{bundle}/Contents/MacOS/SeamlessProxy')
        check('the proxy is a foreground app', 'type="Foreground"' in proxy_kind, proxy_kind[:200])
        vm_kind = kind(f'{app}/Contents/MacOS/Light Click')
        check('the machine\'s app is running, and not in the Dock', 'type="UIElement"' in vm_kind, vm_kind[:200])
        vm_pid = running(f'{app}/Contents/MacOS/Light Click')[0].split()[0]
        windows = subprocess.run([str(results/'seamless-guest'), 'list'], capture_output=True, text=True).stdout
        # With the display asleep WindowServer lists them as on screen even ordered out, so what counts is that they're clear.
        shown = [w for w in windows.splitlines() if f'pid={vm_pid} ' in w and ' alpha=0 ' not in w]
        check('none of its windows can be seen', not shown, '; '.join(shown)[:300])
    if 'the guest\'s side ended' in said or 'ERROR the session stopped' in said:
        break
    time.sleep(5)
print('== Session log\n'+said[-6000:], flush=True)
time.sleep(5)
check('the guest app was seen', 'menu with' in said)
check('the document reached the guest', 'sent ' in said and str(document.name) in said)
check('the save prompt came up as its own window', '# test: at the prompt' in said, next((line for line in said.splitlines() if 'at the prompt' in line), ''))
check('the guest app exited after that', '# the guest app has exited' in said)
after = document.read_bytes()
check('the saved document came back to the host', after != before, repr(after[:80]))
check('the proxy has quit', not running(f'{bundle}/Contents/MacOS/SeamlessProxy'))
for _ in range(36):
    if not running(str(machine)):
        break
    time.sleep(5)
left = running(str(machine))
check('the machine has shut down, and its app has gone', not left, '; '.join(left)[:400])
removed = subprocess.run([str(app/'Contents/Resources/Seamless/SeamlessMakeProxy'), 'remove', bundle], capture_output=True, text=True)
registered = subprocess.run(['/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister', '-dump'],
                            capture_output=True, text=True).stdout
check('the proxy is unregistered and deleted', removed.returncode == 0 and not Path(bundle).exists() and bundle not in registered, removed.stdout[:200])
for row in running(str(machine))+running(f'{bundle}/'):
    os.kill(int(row.split()[0]), signal.SIGKILL)
sys.exit(1 if failures else 0)
