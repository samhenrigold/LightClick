#!/bin/zsh
# Boot an APFS clone and print app/QEMU PIDs, as before. A detached guardian holds the global clone lease until both
# processes exit. BOOT_CLONE_ALLOW_RUNNING does not bypass that lease or allow booting beside a user's VM.
set -eu
root=${0:A:h:h}
exec python3 "$root/scripts/clone_lease.py" "$root" "$@"
