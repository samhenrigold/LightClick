#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
mkdir -p "$root/Build/Probes"
"$root/scripts/clang-with-swift-packages" GuestControl -- -fobjc-arc -fmodules -Wall -mmacosx-version-min=15.0 \
    -I "$root/VirtualIntelMac" -framework Cocoa -framework Metal -framework QuartzCore -lbsm \
    "$root/probes/app-surface-burst.m" \
    "$root/VirtualIntelMac/VIMDisplayConnection.m" "$root/VirtualIntelMac/VIMMetalView.m" \
    -o "$root/Build/Probes/app-surface-burst"
exec "$root/Build/Probes/app-surface-burst"
