#!/usr/bin/env python3
"""Run probes/lc-bench inside a clone of a VM and save its results.

    scripts/guest-bench <app> <machine.vintelmac> <tag> [--env K=V ...] [--qemu ARG ...] [-t SECONDS] [--repeat N]
                        [--events] [--workload SHELL_COMMAND]

Clones the app and machine with APFS under Build/bench/<tag>, so the real library isn't touched. A small
wrapper replaces the clone's QEMU so experiments can set environment variables and extra QEMU arguments
that the app wouldn't pass. Writes Build/bench/<tag>.txt, and the guest's stderr to Build/bench/<tag>.stderr. The
clone's window is titled "Clone of <machine>"; anything changed in it is lost.

--program runs an x86 program as root. For a GPU workload use probes/gpu-bench.m (its header has the build line), which
re-enters the console user's session itself, on any guest from Mavericks up:

    scripts/guest-bench <app> <machine> gpu-on --program Build/bench/gpu-bench
    scripts/guest-bench <app> <machine> gpu-off --program Build/bench/gpu-bench --env VIM_PVG_SLAB=0
    scripts/lc-bench-compare Build/bench/gpu-off.txt Build/bench/gpu-on.txt
"""
import argparse
import atexit
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid

from startup_timeline import StartupTimeline, preserve_startup_logs
from diagnostics_evidence import retain_timeout
from sampling_entitlements import prepare_sampling_entitlements

from clone_lease import CloneLease, LeaseRefused, process_identity

source = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('app', type=Path)
parser.add_argument('machine', type=Path)
parser.add_argument('tag')
parser.add_argument('--env', action='append', default=[])
parser.add_argument('--qemu', action='append', default=[])
parser.add_argument('--plist', action='append', default=[], help='KEY=JSON set in the clone\'s Machine.plist, such as DisplayMode=\'"scaled"\'')
parser.add_argument('-t', default='1')
parser.add_argument('--boot-wait', type=int, default=45)
parser.add_argument('--repeat', type=int, default=1, help='benchmark runs in the same boot; results are the fastest of each test')
parser.add_argument('--events', action='store_true', help='record guest event counts in Build/bench/<tag>.events')
parser.add_argument('--workload', help='run this in the guest with /bin/sh instead of lc-bench')
parser.add_argument('--program', help='stage this local x86 program and run it once, saving its output as Build/bench/<tag>.txt')
parser.add_argument('--driver', type=Path, help='run this Python file in place of a benchmark, with request() and stage() from here')
parser.add_argument('--driver-arg', action='append', default=[], help='passed to --driver as `arguments`')
parser.add_argument('--sample', type=int, help='sample QEMU for this many seconds during the workload, into Build/bench/<tag>.sample')
parser.add_argument('--fresh-identifier', action='store_true', help='give the clone its own machine identifier')
parser.add_argument('--startup-timeline', action='store_true', help='retain passive startup phase observations as <tag>.startup.jsonl')
parser.add_argument('--allow-running-vms', action='store_true', help='allow unrelated running VMs while retaining this harness\'s exclusive clone-test lease')
args = parser.parse_args()
clone_lease = CloneLease(check_running=not args.allow_running_vms)
try:
    clone_lease.acquire()
except (LeaseRefused, OSError, subprocess.TimeoutExpired) as error:
    parser.exit(2, f'REFUSED {error}\n')
# Keep ownership through the cleanup below, including setup failures before its try/finally.
atexit.register(clone_lease.close)
bench = source/'Build/bench/lc-bench'
events = source/'Build/bench'/f'{args.tag}.events'
if args.events:
    args.env.append(f'PVG_TCG_EVENTS={events}')
work = source/'Build/bench'/args.tag
shutil.rmtree(work, ignore_errors=True)
home = work/'home'
library = home/'Library/Application Support/Light Click/Machines'
library.mkdir(parents=True)
# The window title is the package's name, so a clone must not keep the real VM's. A pending rename would restore it.
machine = library/f'Clone of {args.machine.name}'
subprocess.run(['cp', '-c', '-R', str(args.machine), str(machine)], check=True)
(machine/'State/PendingConfiguration.plist').unlink(missing_ok=True)
print(f'WARNING: the window titled "{machine.stem}" is a throwaway clone. Anything changed in it is lost.', flush=True)
for item in args.plist:
    key, value = item.split('=', 1)
    subprocess.run(['plutil', '-replace', key, '-json', value, str(machine/'Machine.plist')], check=True)
# Forwarded ports would clash with any VM already running.
for key in ('SSHEnabled', 'FileSharingEnabled'):
    subprocess.run(['plutil', '-replace', key, '-bool', 'NO', str(machine/'Machine.plist')], check=True)
app = work/args.app.name
subprocess.run(['cp', '-c', '-R', str(args.app), str(app)], check=True)
binary = app/'Contents/Resources/Runtime/bin'
real = binary/'qemu-system-x86_64.real'
(binary/'qemu-system-x86_64').rename(real)
if args.sample:
    # sample(1) needs get-task-allow; preserve all original capabilities, including
    # hypervisor when present. Only this throwaway clone gains sampling permissions.
    entitlements = work/'sample.entitlements'
    prepare_sampling_entitlements(real, entitlements)
    subprocess.run(['codesign', '-f', '-s', '-', '--options', 'runtime', '--entitlements', str(entitlements), str(real)],
                   check=True, stderr=subprocess.DEVNULL)
exports = ' '.join(shlex.quote(item) for item in args.env)
extra = ' '.join(shlex.quote(item) for item in args.qemu)
(binary/'qemu-system-x86_64').write_text(f'#!/bin/sh\nexec env {exports} {shlex.quote(str(real))} {extra} "$@"\n')
(binary/'qemu-system-x86_64').chmod(0o755)
diagnostics = work/'diagnostics'
diagnostics.mkdir(mode=0o700)
if args.fresh_identifier:
    # What a Seamless session's sockets and proxies are named from, which a clone shouldn't share with a live session.
    subprocess.run(['plutil', '-replace', 'Identifier', '-string', str(uuid.uuid4()).upper(), str(machine/'Machine.plist')], check=True)
env = dict(os.environ, CFFIXED_USER_HOME=str(home))
identifier = subprocess.check_output(['plutil', '-extract', 'Identifier', 'raw', '-o', '-', str(machine/'Machine.plist')],
                                     text=True).strip().upper()
channel = diagnostics/identifier
stderr_path = source/'Build/bench'/f'{args.tag}.stderr'
stderr_path.unlink(missing_ok=True)


def request(command, timeout):
    serialized = json.dumps(command)
    encoded = serialized.encode('utf-8')
    if len(encoded) > 65536:
        raise ValueError(f'Diagnostics request is {len(encoded)} UTF-8 bytes; limit is 65536 bytes')
    (channel/'Result.json').unlink(missing_ok=True)
    temporary = channel/'Request.tmp'
    temporary.write_bytes(encoded)
    temporary.rename(channel/'Request.json')
    deadline = time.monotonic()+timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise SystemExit(f'The app exited; see {work}/app.log')
        if (channel/'Result.json').exists():
            result = json.loads((channel/'Result.json').read_text())
            # All of it, in order: a stress program reports its failures here, and they run long.
            with stderr_path.open('a') as file:
                file.write(str(result.get('Stderr') or result.get('Error') or ''))
            return result
        time.sleep(1)
    try:
        retained = retain_timeout(channel, source/'Build/bench', args.tag, app_pid=process.pid, timeout=timeout)
        print(f'Diagnostics timeout evidence: {retained}', file=sys.stderr, flush=True)
    except Exception as error:
        # Evidence is best effort: its failure must not replace the timeout or prevent owned-clone cleanup.
        print(f'Diagnostics timeout evidence could not be retained: {error}', file=sys.stderr, flush=True)
    raise SystemExit(f'Timed out waiting for {command}')


def stage(program):
    shutil.copyfile(program, channel/'Transfer.bin')
    start = time.monotonic()
    staged = request({'Action': 'stage-probe'}, 900)
    if 'Error' in staged:
        raise SystemExit(f'Staging failed: {staged}')
    print(f'staged in {time.monotonic()-start:.0f}s', flush=True)
    path = staged['Transfer']['Directory']+'/Transfer.bin'
    request({'Executable': '/bin/chmod', 'Arguments': ['0755', path]}, 120)
    return path


def stop_test_processes(process, work):
    """Stop this run's processes; unknown ownership leaves its work intact."""
    try:
        process.terminate()
        try:
            process.wait(timeout=6)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=3)
        deadline = time.monotonic()+20
        while time.monotonic() < deadline:
            # process_identity uses UTC; both observations must encode the same birth time regardless of host TZ.
            listing = subprocess.run(['ps', '-axo', 'pid=,stat=,lstart=,comm='], capture_output=True, text=True,
                                     timeout=5, env={**os.environ, 'TZ': 'UTC'})
            if listing.returncode or listing.stderr.strip() or not listing.stdout.strip():
                raise RuntimeError('could not inspect remaining clone processes')
            leftovers = []
            for line in listing.stdout.splitlines():
                fields = line.split(None, 7)
                if len(fields) != 8 or not fields[0].isdigit():
                    raise RuntimeError('incomplete clone process inspection')
                if fields[7].startswith(str(work)+'/') and not fields[1].startswith('Z'):
                    # Path and birth time must come from one snapshot. A later identity lookup could already name
                    # a replacement process if this PID exited immediately after discovery.
                    leftovers.append((int(fields[0]), ' '.join(fields[2:7])))
            if not leftovers:
                return None
            for pid, stamp in leftovers:
                current = process_identity(pid)
                if current is not None and ' '.join(current.split()) == stamp:
                    try:
                        os.kill(pid, signal.SIGKILL if time.monotonic() > deadline-15 else signal.SIGTERM)
                    except ProcessLookupError:
                        pass
            time.sleep(1)
        return 'owned clone processes did not exit'
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        return str(error)


timeline = None
if args.startup_timeline:
    (machine/'State/GuestStatus.plist').unlink(missing_ok=True)
    timeline = StartupTimeline(source/'Build/bench'/f'{args.tag}.startup.jsonl')
    atexit.register(timeline.close)
    timeline.record('app_launch_requested',
                    preparation_delay_policy_seconds=90 if 'LC_SEAMLESS_CLICK_LOG' in env else 20,
                    preparation_enabled='LC_SEAMLESS_CLICK_LOG' in env,
                    preparation_policy='test' if 'LC_SEAMLESS_CLICK_LOG' in env else 'product; diagnostics suppresses prearm')
process = subprocess.Popen([str(app/'Contents/MacOS/Light Click'), '--open-vm', str(machine), '--guest-diagnostics-root',
                            str(diagnostics)], env=env, stdout=(work/'app.log').open('w'), stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL)
try:
    def interrupted(number, frame):
        raise SystemExit(128+number)
    signal.signal(signal.SIGTERM, interrupted)
    if timeline:
        timeline.record('app_launched', pid=process.pid)
        timeline.start(machine, channel, process.pid, real)
    time.sleep(args.boot_wait)
    deadline = time.monotonic()+300
    while not channel.is_dir():
        if time.monotonic() > deadline:
            raise SystemExit('The diagnostics channel never appeared')
        time.sleep(1)
    if args.driver:
        exec(compile(args.driver.read_text(), str(args.driver), 'exec'),
             {'arguments': args.driver_arg, 'channel': channel, 'request': request, 'source': source, 'stage': stage,
              'tag': args.tag, **({'record_phase': timeline.record} if timeline else {})})
    elif args.workload:
        phases = source/'Build/bench'/f'{args.tag}.phases'
        lines = sum(1 for _ in events.open()) if events.exists() else 0
        sampler = None
        if args.sample:
            pid = subprocess.check_output(['pgrep', '-f', str(real)], text=True).split()[0]
            sampler = subprocess.Popen(['/usr/bin/sample', pid, str(args.sample), '10', '-mayDie', '-file',
                                        str(source/'Build/bench'/f'{args.tag}.sample')], stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
        result = request({'Executable': '/bin/sh', 'Arguments': ['-c', args.workload]}, 1200)
        if sampler:
            sampler.wait()
        after = sum(1 for _ in events.open()) if events.exists() else 0
        phases.write_text(f'{lines} {after}\n')
        print(f'workload exit {result.get("ExitCode")}, event seconds {lines} to {after}')
        print(str(result.get('Stderr'))[:300])
    else:
        program = stage(args.program or bench)
        if args.program:
            result = request({'Executable': program, 'Arguments': []}, 900)
            (source/'Build/bench'/f'{args.tag}.txt').write_text(result.get('Stdout', ''))
            print(f'program exit {result.get("ExitCode")} {str(result.get("Stderr"))[:200]}{" "+str(result.get("Error")) if "Error" in result else ""}')
            raise SystemExit(0)
        best = {}
        order = []
        for _ in range(args.repeat):
            result = request({'Executable': program, 'Arguments': ['-t', args.t]}, 900)
            if result.get('ExitCode') != 0:
                raise SystemExit(f'Benchmark failed: {str(result)[:400]}')
            for line in result['Stdout'].splitlines():
                parts = line.split()
                if line.startswith('#') or len(parts) != 3:
                    continue
                value = float(parts[1])
                if parts[0] == 'largecode_cold' and parts[0] in best:
                    continue  # code from the first run is no longer cold
                if parts[0] not in best:
                    order.append(parts[0])
                    best[parts[0]] = (value, parts[2])
                elif (value > best[parts[0]][0]) == (parts[2] == 'MB/s'):
                    best[parts[0]] = (value, parts[2])
        text = '# lc-bench arch=x86_64 t='+args.t+'\n'+''.join(f'{n} {best[n][0]:.3f} {best[n][1]}\n' for n in order)
        (source/'Build/bench'/f'{args.tag}.txt').write_text(text)
        print(text)
finally:
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        if timeline:
            timeline.record('cleanup_started')
    finally:
        # Optional evidence must never prevent cleanup of a successfully spawned clone.
        cleanup_failure = stop_test_processes(process, work)
    if timeline:
        timeline.record('process_cleanup_finished', error=cleanup_failure)
        copied = preserve_startup_logs(work, source/'Build/bench', args.tag, Path(env.get('TMPDIR', '/tmp')),
                                       identifier, args.fresh_identifier, machine=machine)
        timeline.record('startup_logs_retained', paths=copied, fresh_identifier=args.fresh_identifier)
        timeline.close()
    if (machine/'State/session.log').exists():
        shutil.copyfile(machine/'State/session.log', source/'Build/bench'/f'{args.tag}.session.log')
    if cleanup_failure:
        raise RuntimeError(f'Clone cleanup failed: {cleanup_failure}; retained evidence at {work}')
    shutil.rmtree(work, ignore_errors=True)
    # CFFIXED_USER_HOME doesn't redirect preferences: remove what this clone's paths left in them.
    listing = subprocess.run(['defaults', 'read', 'gold.samhenri.LightClick'], capture_output=True, text=True).stdout
    for line in listing.splitlines():
        key = line.strip().split(' = ')[0].strip('"')
        if str(work) in key and line.startswith('    "'):  # Keys nested under one already deleted are gone with it.
            subprocess.run(['defaults', 'delete', 'gold.samhenri.LightClick', key], check=False)
