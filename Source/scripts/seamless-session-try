#!/usr/bin/env python3
"""One guest app as a host app, from nothing running to nothing left, in throwaway clones of the app and machine.

    scripts/seamless-session-try <app built by build-app> <machine.vintelmac>

Has the app make a TextEdit proxy from the running clone, the same way as Actions > Make Dock App…, which installs the hook
and shuts the clone down. Then opens the proxy with a document, as LaunchServices would for a Dock tile or a drop, with no VM
running. The proxy starts the app with no window, the app starts the session, the guest boots, and the document opens. The
session then types into the document and a new one, asks the proxy to quit, answers the save prompt that brings, and the
machine shuts down. Prints PASS or FAIL per step. The composed image at the prompt, made from the windows' exact pixels and
not read from the screen, is Build/seamless/seamless-session-prompt.png.
"""
import json
import os
from pathlib import Path
import plistlib
import shutil
import signal
import subprocess
import sys
import tempfile
import time

source = Path(__file__).resolve().parents[1]
if len(sys.argv) != 3:
    sys.exit(__doc__)
original_app, original_machine = Path(sys.argv[1]), Path(sys.argv[2])
results = source/'Build/seamless'
results.mkdir(parents=True, exist_ok=True)
work = source/'Build/bench/seamless-session'
shutil.rmtree(work, ignore_errors=True)
home = work/'home'
library = home/'Library/Application Support/Light Click/Machines'
library.mkdir(parents=True)
machine = library/f'Clone of {original_machine.name}'
subprocess.run(['cp', '-c', '-R', str(original_machine), str(machine)], check=True)
(machine/'State/PendingConfiguration.plist').unlink(missing_ok=True)
if os.environ.get('SEAMLESS_SCALE') == '1':
    for key, value in (('DisplayMode', '"scaled"'), ('RetinaEnabled', 'false')):
        subprocess.run(['plutil', '-replace', key, '-json', value, str(machine/'Machine.plist')], check=True)
for key in ('SSHEnabled', 'FileSharingEnabled'):
    subprocess.run(['plutil', '-replace', key, '-bool', 'NO', str(machine/'Machine.plist')], check=True)
print(f'WARNING: "{machine.stem}" is a throwaway clone, and preferences stay shared with the real app.', flush=True)
app = work/original_app.name
subprocess.run(['cp', '-c', '-R', str(original_app), str(app)], check=True)
identifier = plistlib.loads((machine/'Machine.plist').read_bytes())['Identifier']

failures = 0


def check(name, passed, detail=''):
    global failures
    failures += not passed
    text = f'{"PASS" if passed else "FAIL"} {name}{": " + detail if detail else ""}'
    print(text, flush=True)
    # Every run's verdicts stay, so an intermittent failure can be read back after the terminal has gone.
    with (results/'seamless-session-checks.txt').open('a') as history:
        history.write(f'{time.strftime("%F %T")} {machine.stem} {text}\n')


def running(pattern):
    rows = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, text=True).stdout.splitlines()
    return [row.strip() for row in rows if pattern in row and 'seamless-session-try' not in row]


check('no machine is running this clone before making the proxy', not running(str(machine)))
env = dict(os.environ, CFFIXED_USER_HOME=str(home), LC_HVDBT='1')
maker = subprocess.run([str(app/'Contents/MacOS/Light Click'), '--open-vm', str(machine), '--seamless-make-proxy', 'TextEdit'],
                       env=env, capture_output=True, text=True, timeout=1200)
bundle = next((line for line in maker.stdout.splitlines() if line.endswith('.app')), '')
check('the app made a proxy, and shut the machine down', bool(bundle) and maker.returncode == 0 and not running(str(machine)), maker.stdout[-300:])
if not bundle:
    print(maker.stderr[-2000:])
    sys.exit(1)
info = plistlib.loads((Path(bundle)/'Contents/Info.plist').read_bytes())
socket_path = Path(info['LCSessionSocket'])
import secrets


def session(name, cancel=False):
    """One launch from the proxy with a document, to the machine having shut down."""
    print(f'== {name}', flush=True)
    log = Path(str(socket_path)+'.log')
    log.unlink(missing_ok=True)
    document = work/f'A note for {name}.txt'
    document.write_text('Written on the host.\n')
    before = document.read_bytes()
    marker = work/f'Marker {secrets.token_hex(4)}.txt'
    marker.write_text(f'Only this drag: {secrets.token_hex(16)}\n')
    dragged_out = work/f'dragged-out-{name}'
    dragged_out.mkdir()
    screenshot = results/f'seamless-session-{name}.png'
    arguments = '\n'.join([str(dragged), str(marker), str(dragged_out), str(screenshot), 'cancel' if cancel else 'save'])
    check('no machine is running this clone before the proxy opens', not running(str(machine)))
    subprocess.run(['/usr/bin/open', '--env', f'CFFIXED_USER_HOME={home}', '--env', f'LC_SEAMLESS_TEST={arguments}', '-a', bundle, str(document)], check=True)
    print('# opened the proxy with a document', flush=True)
    launch_checked = False
    deadline = time.time()+1500
    said = ''
    while time.time() < deadline:
        said = log.read_text(errors='replace') if log.exists() else ''
        if not launch_checked and 'running TextEdit' in said:
            launch_checked = True
            def kind(pattern):
                pid = running(pattern)[0].split()[0] if running(pattern) else '0'
                listing = subprocess.run(['lsappinfo', 'list'], capture_output=True, text=True).stdout
                return next((line.strip() for line in listing.splitlines() if f'pid = {pid} ' in line), '')
            proxy_kind = kind(f'{bundle}/Contents/MacOS/SeamlessProxy')
            check('the proxy is a foreground app', 'type="Foreground"' in proxy_kind, proxy_kind[:80])
            vm_kind = kind(f'{app}/Contents/MacOS/Light Click')
            check('the machine\'s app is running, and not in the Dock', 'type="UIElement"' in vm_kind, vm_kind[:80])
            vm_pid = running(f'{app}/Contents/MacOS/Light Click')[0].split()[0]
            windows = subprocess.run([str(results/'seamless-guest'), 'list'], capture_output=True, text=True).stdout
            # With the display asleep WindowServer lists them as on screen even ordered out, so what counts is that they're clear.
            shown = [w for w in windows.splitlines() if f'pid={vm_pid} ' in w and ' alpha=0 ' not in w]
            check('none of its windows can be seen', not shown, '; '.join(shown)[:300])
        if 'the guest\'s side ended' in said or 'ERROR the session stopped' in said:
            break
        time.sleep(2)
    (results/f'seamless-session-{name}.log').write_text(said)
    print('== Session log\n'+said[-3000:], flush=True)
    time.sleep(5)
    def line(text):
        return next((l for l in said.splitlines() if text in l), '')
    check('the guest app was seen', '# window ' in said)
    check('the document reached the guest', 'sent ' in said and document.name in said)
    check('the save prompt came up as its own window', '# test: at the prompt' in said, line('at the prompt')[:160])
    if cancel:
        check('Cancel left the app running with its windows', 'the proxy is running' in said and ', 0 windows' not in line('after Cancel'), line('after Cancel'))
    check('the guest app exited after that', '# the guest app has exited' in said)
    after = document.read_bytes()
    check('the saved document came back to the host', after != before, repr(after[:80]))
    check('a guest drop was taken', 'drag_ended' in said, line('drag_ended'))
    came_out = dragged_out/marker.name
    check('this drag, and no other, came out as a promised file', came_out.exists() and came_out.read_bytes() == marker.read_bytes())
    check('the guest app\'s badge reached the session', 'badge "7"' in said, line('badge "7"'))
    check('and the proxy\'s tile, by AppKit', 'tile says "7"' in said, line('tile says "7"'))
    check('its request for attention reached the session', 'attention true' in said, line('attention true'))
    check('a scroll came through the input view', ' 0 gesture' not in said and ' gesture' in said, line('input ')[:60])
    check('the proxy has quit', not running(f'{bundle}/Contents/MacOS/SeamlessProxy'))
    for _ in range(36):
        if not running(str(machine)):
            break
        time.sleep(5)
    left = running(str(machine))
    check('the machine has shut down, and its app has gone', not left, '; '.join(left)[:300])
    for row in left:
        os.kill(int(row.split()[0]), signal.SIGKILL)


dragged = work/'Dragged from the host.txt'
dragged.write_text('Dragged in.\n')
results.mkdir(parents=True, exist_ok=True)
# Something left at the socket's path by anything before: the session has to deal with it.
if socket_path.is_dir():
    shutil.rmtree(socket_path)
else:
    socket_path.unlink(missing_ok=True)
socket_path.mkdir()
session('first')
session('second', cancel=True)

# With another Light Click holding the machine, the proxy has to say so and leave, rather than bounce for ever.
holder = subprocess.Popen([str(app/'Contents/MacOS/Light Click'), '--open-vm', str(machine)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
time.sleep(20)
log = Path(str(socket_path)+'.log')
log.unlink(missing_ok=True)
marker = work/'x.txt'
marker.write_text('x')
subprocess.run(['/usr/bin/open', '--env', f'CFFIXED_USER_HOME={home}', '--env', 'LC_SEAMLESS_TEST=a\nb\nc\nd\ne', bundle], check=True)
gone = False
for _ in range(36):
    time.sleep(5)
    if not running(f'{bundle}/Contents/MacOS/SeamlessProxy') and 'session stopped' in (log.read_text(errors='replace') if log.exists() else ''):
        gone = True
        break
check('a proxy opened while another app holds the machine says so, and quits', gone, log.read_text(errors='replace')[-200:] if log.exists() else 'no log')
check('the holding app is unharmed', holder.poll() is None)
holder.terminate()
time.sleep(5)
for row in running(str(machine))+running(f'{bundle}/'):
    os.kill(int(row.split()[0]), signal.SIGKILL)

lsregister = '/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister'
removed = subprocess.run([lsregister, '-u', bundle], capture_output=True, text=True)
shutil.rmtree(bundle)
registered = subprocess.run(['/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister', '-dump'],
                            capture_output=True, text=True).stdout
check('the proxy is unregistered and deleted', removed.returncode == 0 and not Path(bundle).exists() and bundle not in registered, removed.stdout[:200])
for row in running(str(machine))+running(f'{bundle}/'):
    os.kill(int(row.split()[0]), signal.SIGKILL)
sys.exit(1 if failures else 0)
