#!/usr/bin/env python3
"""Run probes/lc-bench inside a clone of a VM and save its results.

    scripts/guest-bench <app> <machine.vintelmac> <tag> [--env K=V ...] [--qemu ARG ...] [-t SECONDS] [--repeat N]
                        [--events] [--workload SHELL_COMMAND]

Clones the app and machine with APFS under Build/bench/<tag>, so the real library isn't touched. A small
wrapper replaces the clone's QEMU so experiments can set environment variables and extra QEMU arguments
that the app wouldn't pass. Writes Build/bench/<tag>.txt, and the guest's stderr to Build/bench/<tag>.stderr. The
clone's window is titled "Clone of <machine>"; anything changed in it is lost.

--program runs an x86 program as root. For a GPU workload use probes/gpu-bench.m (its header has the build line), which
re-enters the console user's session itself, on any guest from Mavericks up:

    scripts/guest-bench <app> <machine> gpu-on --program Build/bench/gpu-bench
    scripts/guest-bench <app> <machine> gpu-off --program Build/bench/gpu-bench --env VIM_PVG_SLAB=0
    scripts/lc-bench-compare Build/bench/gpu-off.txt Build/bench/gpu-on.txt
"""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import time

source = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('app', type=Path)
parser.add_argument('machine', type=Path)
parser.add_argument('tag')
parser.add_argument('--env', action='append', default=[])
parser.add_argument('--qemu', action='append', default=[])
parser.add_argument('-t', default='1')
parser.add_argument('--boot-wait', type=int, default=45)
parser.add_argument('--repeat', type=int, default=1, help='benchmark runs in the same boot; results are the fastest of each test')
parser.add_argument('--events', action='store_true', help='record guest event counts in Build/bench/<tag>.events')
parser.add_argument('--workload', help='run this in the guest with /bin/sh instead of lc-bench')
parser.add_argument('--program', help='stage this local x86 program and run it once, saving its output as Build/bench/<tag>.txt')
parser.add_argument('--sample', type=int, help='sample QEMU for this many seconds during the workload, into Build/bench/<tag>.sample')
args = parser.parse_args()
bench = source/'Build/bench/lc-bench'
events = source/'Build/bench'/f'{args.tag}.events'
if args.events:
    args.env.append(f'PVG_TCG_EVENTS={events}')
work = source/'Build/bench'/args.tag
shutil.rmtree(work, ignore_errors=True)
home = work/'home'
library = home/'Library/Application Support/Light Click/Machines'
library.mkdir(parents=True)
# The window title is the package's name, so a clone must not keep the real VM's. A pending rename would restore it.
machine = library/f'Clone of {args.machine.name}'
subprocess.run(['cp', '-c', '-R', str(args.machine), str(machine)], check=True)
(machine/'State/PendingConfiguration.plist').unlink(missing_ok=True)
print(f'WARNING: the window titled "{machine.stem}" is a throwaway clone. Anything changed in it is lost.', flush=True)
# Forwarded ports would clash with any VM already running.
for key in ('SSHEnabled', 'FileSharingEnabled'):
    subprocess.run(['plutil', '-replace', key, '-bool', 'NO', str(machine/'Machine.plist')], check=True)
app = work/args.app.name
subprocess.run(['cp', '-c', '-R', str(args.app), str(app)], check=True)
binary = app/'Contents/Resources/Runtime/bin'
real = binary/'qemu-system-x86_64.real'
(binary/'qemu-system-x86_64').rename(real)
if args.sample:
    # sample(1) needs get-task-allow; only this throwaway clone gets it.
    entitlements = work/'sample.entitlements'
    entitlements.write_text('<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict>'
                            '<key>com.apple.security.cs.allow-jit</key><true/>'
                            '<key>com.apple.security.cs.disable-library-validation</key><true/>'
                            '<key>com.apple.security.get-task-allow</key><true/></dict></plist>')
    subprocess.run(['codesign', '-f', '-s', '-', '--options', 'runtime', '--entitlements', str(entitlements), str(real)],
                   check=True, stderr=subprocess.DEVNULL)
exports = ' '.join(shlex.quote(item) for item in args.env)
extra = ' '.join(shlex.quote(item) for item in args.qemu)
(binary/'qemu-system-x86_64').write_text(f'#!/bin/sh\nexec env {exports} {shlex.quote(str(real))} {extra} "$@"\n')
(binary/'qemu-system-x86_64').chmod(0o755)
diagnostics = work/'diagnostics'
diagnostics.mkdir(mode=0o700)
env = dict(os.environ, CFFIXED_USER_HOME=str(home))
process = subprocess.Popen([str(app/'Contents/MacOS/Light Click'), '--open-vm', str(machine), '--guest-diagnostics-root',
                            str(diagnostics)], env=env, stdout=(work/'app.log').open('w'), stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL)
identifier = subprocess.check_output(['plutil', '-extract', 'Identifier', 'raw', '-o', '-', str(machine/'Machine.plist')],
                                     text=True).strip().upper()
channel = diagnostics/identifier
stderr_path = source/'Build/bench'/f'{args.tag}.stderr'
stderr_path.unlink(missing_ok=True)


def request(command, timeout):
    (channel/'Result.json').unlink(missing_ok=True)
    temporary = channel/'Request.tmp'
    temporary.write_text(json.dumps(command))
    temporary.rename(channel/'Request.json')
    deadline = time.time()+timeout
    while time.time() < deadline:
        if process.poll() is not None:
            raise SystemExit(f'The app exited; see {work}/app.log')
        if (channel/'Result.json').exists():
            result = json.loads((channel/'Result.json').read_text())
            # All of it, in order: a stress program reports its failures here, and they run long.
            with stderr_path.open('a') as file:
                file.write(str(result.get('Stderr') or result.get('Error') or ''))
            return result
        time.sleep(1)
    raise SystemExit(f'Timed out waiting for {command}')


try:
    time.sleep(args.boot_wait)
    deadline = time.time()+300
    while not channel.is_dir():
        if time.time() > deadline:
            raise SystemExit('The diagnostics channel never appeared')
        time.sleep(1)
    if args.workload:
        phases = source/'Build/bench'/f'{args.tag}.phases'
        lines = sum(1 for _ in events.open()) if events.exists() else 0
        sampler = None
        if args.sample:
            pid = subprocess.check_output(['pgrep', '-f', str(real)], text=True).split()[0]
            sampler = subprocess.Popen(['/usr/bin/sample', pid, str(args.sample), '10', '-mayDie', '-file',
                                        str(source/'Build/bench'/f'{args.tag}.sample')], stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
        result = request({'Executable': '/bin/sh', 'Arguments': ['-c', args.workload]}, 1200)
        if sampler:
            sampler.wait()
        after = sum(1 for _ in events.open()) if events.exists() else 0
        phases.write_text(f'{lines} {after}\n')
        print(f'workload exit {result.get("ExitCode")}, event seconds {lines} to {after}')
        print(str(result.get('Stderr'))[:300])
    else:
        shutil.copyfile(args.program or bench, channel/'Transfer.bin')
        start = time.time()
        staged = request({'Action': 'stage-probe'}, 900)
        if 'Error' in staged:
            raise SystemExit(f'Staging failed: {staged}')
        print(f'staged in {time.time()-start:.0f}s', flush=True)
        program = staged['Transfer']['Directory']+'/Transfer.bin'
        request({'Executable': '/bin/chmod', 'Arguments': ['0755', program]}, 120)
        if args.program:
            result = request({'Executable': program, 'Arguments': []}, 900)
            (source/'Build/bench'/f'{args.tag}.txt').write_text(result.get('Stdout', ''))
            print(f'program exit {result.get("ExitCode")} {str(result.get("Stderr"))[:200]}{" "+str(result.get("Error")) if "Error" in result else ""}')
            raise SystemExit(0)
        best = {}
        order = []
        for _ in range(args.repeat):
            result = request({'Executable': program, 'Arguments': ['-t', args.t]}, 900)
            if result.get('ExitCode') != 0:
                raise SystemExit(f'Benchmark failed: {str(result)[:400]}')
            for line in result['Stdout'].splitlines():
                parts = line.split()
                if line.startswith('#') or len(parts) != 3:
                    continue
                value = float(parts[1])
                if parts[0] == 'largecode_cold' and parts[0] in best:
                    continue  # code from the first run is no longer cold
                if parts[0] not in best:
                    order.append(parts[0])
                    best[parts[0]] = (value, parts[2])
                elif (value > best[parts[0]][0]) == (parts[2] == 'MB/s'):
                    best[parts[0]] = (value, parts[2])
        text = '# lc-bench arch=x86_64 t='+args.t+'\n'+''.join(f'{n} {best[n][0]:.3f} {best[n][1]}\n' for n in order)
        (source/'Build/bench'/f'{args.tag}.txt').write_text(text)
        print(text)
finally:
    process.send_signal(signal.SIGTERM)
    time.sleep(6)
    if process.poll() is None:
        process.kill()
    # Everything left that runs from this clone: its QEMU, and any helper QEMU spawned.
    deadline = time.time()+20
    while time.time() < deadline:
        listing = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, text=True).stdout
        # Match the executable's path only: another app's VM may be using a disk in this folder.
        leftovers = [int(line.split()[0]) for line in listing.splitlines()
                     if line.split(None, 1)[1].startswith(str(work)+'/')]
        if not leftovers:
            break
        for pid in leftovers:
            os.kill(pid, signal.SIGKILL if time.time() > deadline-15 else signal.SIGTERM)
        time.sleep(1)
    else:
        print(f'WARNING: processes from {work} are still running')
    if (machine/'State/session.log').exists():
        shutil.copyfile(machine/'State/session.log', source/'Build/bench'/f'{args.tag}.session.log')
    shutil.rmtree(work, ignore_errors=True)
    # CFFIXED_USER_HOME doesn't redirect preferences: remove what this clone's paths left in them.
    listing = subprocess.run(['defaults', 'read', 'gold.samhenri.LightClick'], capture_output=True, text=True).stdout
    for line in listing.splitlines():
        key = line.strip().split(' = ')[0].strip('"')
        if str(work) in key:
            subprocess.run(['defaults', 'delete', 'gold.samhenri.LightClick', key], check=False)
