// The Light Click app target.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_ENTITLEMENTS = Light Click.entitlements
CODE_SIGN_STYLE = Automatic
COMBINE_HIDPI_IMAGES = YES
CURRENT_PROJECT_VERSION = 4
ENABLE_APP_SANDBOX = NO
// embed-dev-runtime reads a packaged app whose files can't be listed as phase inputs.
ENABLE_USER_SCRIPT_SANDBOXING = NO
GENERATE_INFOPLIST_FILE = YES
// SwiftPM imparts only a module map to clients; its generated X-Swift.h headers land here, for #import "X-Swift.h".
HEADER_SEARCH_PATHS = $(inherited) "$(GENERATED_MODULEMAP_DIR)"
INFOPLIST_FILE = support/App-Info.plist
INFOPLIST_KEY_NSMainNibFile = MainMenu
INFOPLIST_KEY_NSMicrophoneUsageDescription = Allow your virtual Macs to use this Mac’s microphone when a guest app records audio.
INFOPLIST_KEY_NSPrincipalClass = NSApplication
INFOPLIST_KEY_NSViewGestureRecognizerIsExclusive = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
MARKETING_VERSION = 2.0
PRODUCT_BUNDLE_IDENTIFIER = gold.samhenri.LightClick
PRODUCT_NAME = $(TARGET_NAME)
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 6.0
