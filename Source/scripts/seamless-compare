#!/usr/bin/env python3
"""The bar for seamless: the same animated page, windowed and seamless, in clones of the same machine.

    scripts/seamless-compare <app built by build-app> <machine.vintelmac>

Fails unless seamless delivers at least 90% of windowed's frames per second, counted where each path's frames reach the app.
The proxy's window is saved with screencapture -l, by window, so whether what's on the display is right can be checked.
"""
import os
from pathlib import Path
import plistlib
import re
import shutil
import subprocess
import sys
import time

source = Path(__file__).resolve().parents[1]
os.environ['VIM_COUNT_DISTINCT_FRAMES'] = '1'
original_app, original_machine = Path(sys.argv[1]), Path(sys.argv[2])
results = source/'Build/seamless'
results.mkdir(parents=True, exist_ok=True)
tag = original_machine.stem.split()[0].lower()

windowed = subprocess.run([str(source/'scripts/guest-bench'), str(original_app), str(original_machine), f'seamless-compare-{tag}', '--driver',
                           str(source/'probes/seamless-driver.py'), '--driver-arg', 'windowed', '--env', 'LC_HVDBT=1'],
                          capture_output=True, text=True)
print(windowed.stdout[-800:], windowed.stderr[-300:], flush=True)
match = re.search(r'windowed_distinct ([0-9.]+)', windowed.stdout)
windowed_rate = float(match.group(1)) if match else 0
shutil.rmtree(source/f'Build/bench/seamless-compare-{tag}', ignore_errors=True)

work = source/'Build/bench/seamless-compare-session'
shutil.rmtree(work, ignore_errors=True)
home = work/'home'
library = home/'Library/Application Support/Light Click/Machines'
library.mkdir(parents=True)
machine = library/f'Clone of {original_machine.name}'
subprocess.run(['cp', '-c', '-R', str(original_machine), str(machine)], check=True)
(machine/'State/PendingConfiguration.plist').unlink(missing_ok=True)
for key in ('SSHEnabled', 'FileSharingEnabled'):
    subprocess.run(['plutil', '-replace', key, '-bool', 'NO', str(machine/'Machine.plist')], check=True)
app = work/original_app.name
subprocess.run(['cp', '-c', '-R', str(original_app), str(app)], check=True)
env = dict(os.environ, CFFIXED_USER_HOME=str(home), LC_HVDBT='1')
made = subprocess.run([str(app/'Contents/MacOS/Light Click'), '--open-vm', str(machine), '--seamless-make-proxy', 'Safari'], env=env, capture_output=True, text=True, timeout=1200)
bundle = next((line for line in made.stdout.splitlines() if line.endswith('.app')), '')
if not bundle:
    sys.exit('Couldn\'t make the proxy: '+made.stderr[-800:])
socket_path = plistlib.loads((Path(bundle)/'Contents/Info.plist').read_bytes())['LCSessionSocket']
log = Path(socket_path+'.log')


def running(pattern):
    rows = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, text=True).stdout.splitlines()
    return [row.strip() for row in rows if pattern in row]


def session(label, extra):
    log.unlink(missing_ok=True)
    page = work/f'{label}.html'
    page.write_text('<title>Seamless page</title><style>@-webkit-keyframes m{to{-webkit-transform:translate3d(400px,0,0)}}'
                    'div{width:80px;height:80px;background:#28c;-webkit-animation:m 2s infinite alternate}</style>'
                    '<h1>A page in a guest browser</h1><div></div><p>Some text.</p>\n')
    subprocess.run(['/usr/bin/open', '-g', '--env', f'CFFIXED_USER_HOME={home}', '--env', 'LC_SEAMLESS_QUIET=1', '--env', 'VIM_COUNT_DISTINCT_FRAMES=1', '--env', 'LC_SEAMLESS_STOP_AFTER=45',
                    *[item for pair in extra for item in ('--env', pair)], '-a', bundle, str(page)], check=True)
    deadline = time.time()+900
    said = ''
    while time.time() < deadline:
        said = log.read_text(errors='replace') if log.exists() else ''
        if 'guest\'s side ended' in said:
            break
        # While it's showing: this app's windows only, never the whole screen.
        proxies = running(f'{bundle}/Contents/MacOS/SeamlessProxy')
        if proxies and 'running Safari' in said and not (results/f'seamless-compare-{tag}-{label}.png').exists():
            pid = proxies[0].split()[0]
            listing = subprocess.run([str(results/'seamless-guest'), 'list'], capture_output=True, text=True).stdout
            rows = [line for line in listing.splitlines() if f'pid={pid} ' in line and ' 0x0' not in line]
            if rows and time.time() > deadline - 900 + 60:
                subprocess.run(['screencapture', '-x', '-o', '-l', re.search(r'id=(\d+)', rows[0]).group(1), str(results/f'seamless-compare-{tag}-{label}.png')])
        time.sleep(2)
    (results/f'seamless-compare-{tag}-{label}.log').write_text(said)
    for _ in range(36):
        if not running(str(machine)):
            break
        time.sleep(5)
    for row in running(str(machine))+running(f'{bundle}/'):
        os.kill(int(row.split()[0]), 9)
    rate = re.search(r'# frames: [0-9.]+/s, ([0-9.]+) distinct', said)
    return float(rate.group(1)) if rate else 0, said


frames_rate, said = session('frames', [])
print(f'distinct frames/s: windowed {windowed_rate:.1f}; seamless, cropping those frames, {frames_rate:.1f}', flush=True)
subprocess.run(['/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister', '-u', bundle])
shutil.rmtree(work, ignore_errors=True)
if frames_rate < windowed_rate * 0.9 or windowed_rate <= 0:
    print('FAIL: seamless doesn\'t match windowed')
    sys.exit(1)
print('PASS: seamless matches windowed')
