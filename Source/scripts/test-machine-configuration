#!/bin/bash
set -euo pipefail
source_dir="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p "$source_dir/Build/Probes"
"$source_dir/scripts/clang-with-swift-packages" InstallerKit MachineKit -- -fobjc-arc -fmodules -mmacosx-version-min=15.0 \
  -I "$source_dir/VirtualIntelMac" "$source_dir/probes/machine-configuration-tests.m" \
  "$source_dir/VirtualIntelMac/VIMMachine.m" "$source_dir/VirtualIntelMac/VIMInstallerAssembly.m" \
  "$source_dir/VirtualIntelMac/VIMFirmwareBoot.m" \
  "$source_dir/VirtualIntelMac/VIMAlerts.m" \
  "$source_dir/VirtualIntelMac/VIMNetworkDefaults.m" \
  "$source_dir/VirtualIntelMac/VIMAutomaticSetup.m" \
  "$source_dir/VirtualIntelMac/VIMHFSInstallerDisk.c" \
  -framework Cocoa -framework Security -o "$source_dir/Build/Probes/machine-configuration-tests"
"$source_dir/Build/Probes/machine-configuration-tests"
