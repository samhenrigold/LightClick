#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
mkdir -p "$root/Build/Probes"
"$root/scripts/clang-with-swift-packages" InstallerKit MachineKit -- -fobjc-arc -fmodules -Wall -mmacosx-version-min=15.0 \
    -I "$root/VirtualIntelMac" -framework AppKit -framework Security \
    "$root/probes/installer-validation-tests.m" "$root/VirtualIntelMac/VIMInstallerAssembly.m" \
    "$root/VirtualIntelMac/VIMAlerts.m" \
    "$root/VirtualIntelMac/VIMHFSInstallerDisk.c" \
    -o "$root/Build/Probes/installer-validation-tests"
exec "$root/Build/Probes/installer-validation-tests" "$@"
