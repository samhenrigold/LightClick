#!/usr/bin/env python3
"""One disposable Mojave clone, idle brackets and a resident warm HEVC/tally phase. No Seamless or UI fixture.
Requires the already-built repeat-capable x86_64 image-decode probe; this wrapper never builds anything.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import plistlib
import signal
import stat
import struct
import subprocess
import sys
import time


def main():
    source = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('app', type=Path)
    parser.add_argument('machine', type=Path)
    parser.add_argument('probe', type=Path)
    parser.add_argument('reference', type=Path, help='prior successful same-space guest report, not the modern host report')
    parser.add_argument('--results', type=Path, required=True, help='new host evidence directory')
    parser.add_argument('--seconds', type=int, choices=range(10, 31), default=30)
    parser.add_argument('--idle-seconds', type=int, choices=range(8, 31), default=12)
    parser.add_argument('--deadline', type=int, default=1200)
    parser.add_argument('--boot-wait', type=int, default=90, help='warm-profile startup wait before driver, seconds0..600')
    parser.add_argument('--allow-running-vms', action='store_true', help="allow other chats' VMs; guest-bench still owns the exclusive clone lease")
    parser.add_argument('--profile-invalidations', action='store_true', help='enable sampled Engine invalidation timing; new runtime required')
    args = parser.parse_args()
    app, machine, probe, reference, output = (path.resolve() for path in (args.app, args.machine, args.probe, args.reference, args.results))
    if not 0 <= args.boot_wait <= 600:
        parser.error('boot-wait must be0..600s')
    if not 120 <= args.deadline <= 1800:
        parser.error('deadline must be120..1800s')
    if not (app/'Contents/MacOS/Light Click').is_file() or not (machine/'Machine.plist').is_file():
        parser.error('built app and prepared machine required')
    with (machine/'Machine.plist').open('rb') as file:
        configuration = plistlib.load(file)
    cpus = configuration.get('CPUCount')
    if configuration.get('Guest') != 'mojave' or type(cpus) is not int or not 1 <= cpus <= 8:
        parser.error('requires Mojave with1..8configuredvCPUs')
    if output.exists() or output.is_relative_to(app) or output.is_relative_to(machine):
        parser.error('results must be new and outside app/machine')
    info = probe.lstat()
    if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= 16*1024*1024:
        parser.error('probe must be a small regular file')
    with probe.open('rb') as file:
        header = file.read(8)
    if len(header) != 8 or struct.unpack('<II', header) != (0xfeedfacf, 0x1000007):
        parser.error('probe must be the existing thin x86_64 Mach-O')
    prior = json.loads(reference.read_text())
    if prior.get('input_sha256') != 'a84ed4faa376b8b2cb0328b306d09d25ad9047a0f7d106ad46098d0d91381256' or prior.get('requested_output_color_space') not in ('source', 'srgb'):
        parser.error('reference must describe verified fixed Mojave OS image in source/srgb mode')
    output.mkdir(parents=True)
    (output/'tallies').mkdir()
    prefix = output/'tallies/engine.txt'
    tag = 'hevc-tally-' + time.strftime('%Y%m%d-%H%M%S-') + str(os.getpid())
    command = [sys.executable, str(source/'scripts/guest-bench'), str(app), str(machine), tag,
               '--fresh-identifier', '--boot-wait', str(args.boot_wait), '--env', 'LC_HVDBT=1', '--env', 'LC_HVDBT_TALLY='+str(prefix),
               '--driver', str(source/'probes/hevc-tally-driver.py')]
    if args.allow_running_vms:
        command += ['--allow-running-vms']
    if args.profile_invalidations:
        command += ['--env', 'LC_HVDBT_PROFILE_INVALIDATION=1']
    for value in (output/'measurements', probe, prefix, cpus, args.seconds, args.idle_seconds, reference, int(args.profile_invalidations)):
        command += ['--driver-arg', str(value)]
    # Diagnostics normally suppresses prearm; don't accidentally inherit a prior Seamless experiment's opt-ins.
    environment = {key: value for key, value in os.environ.items() if not key.startswith(('LC_SEAMLESS_', 'VIM_SEAMLESS_')) and key != 'LC_HVDBT_PROFILE_INVALIDATION'}
    (output/'invocation.json').write_text(json.dumps(dict(command=command, probe_sha256=hashlib.sha256(probe.read_bytes()).hexdigest(),
        app=str(app), machine=str(machine), reference=str(reference), profile_invalidations=args.profile_invalidations,
        note='Guest-bench owns clone cleanup and the single-clone lease. No build or application benchmark.'), indent=2)+'\n')
    interrupted = [0]
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, lambda number, frame: interrupted.__setitem__(0, number))
    with (output/'runner.log').open('w') as log:
        process = subprocess.Popen(command, env=environment, stdin=subprocess.DEVNULL, stdout=log,
                                   stderr=subprocess.STDOUT, start_new_session=True)
        try:
            deadline = time.monotonic()+args.deadline
            while process.poll() is None and not interrupted[0] and time.monotonic() < deadline:
                time.sleep(.2)
        finally:
            if process.poll() is None:
                process.terminate() # guest-bench must finish its app/VM cleanup before the owned group is killed.
                try:
                    process.wait(timeout=60)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.wait(timeout=5)
    if interrupted[0] or process.returncode or time.monotonic() >= deadline:
        print('FAIL/INCOMPLETE HEVC tally collection; retained evidence ' + str(output))
        return 128+interrupted[0] if interrupted[0] else 1
    print('COLLECTED resident warm decode/tallies; inspect interval coverage and verification hashes: ' + str(output))
    return 0


if __name__ == '__main__':
    sys.exit(main())
